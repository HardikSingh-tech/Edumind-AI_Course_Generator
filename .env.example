# EduMind Backend Environment Variables

# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/edumind_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# Gemini / OpenAI API Configuration
SPRING_AI_OPENAI_API_KEY=your_gemini_api_key_here
SPRING_AI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gemini-flash-lite-latest

# Allowed CORS Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200
